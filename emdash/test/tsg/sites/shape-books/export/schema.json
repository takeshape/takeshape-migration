            "title": "Deck",
            "minLength": 0,
            "@mapping": "shapedb:Post.HkJzKRDUb"
          },
          "tags": {
            "title": "Tags",
            "@mapping": "shapedb:Post.Hkb57EkOQ",
            "items": {
              "@ref": "local:Tag"
            },
            "@backreference": {
              "enabled": true
            },
            "type": "array",
            "@input": {
              "type": "array",
              "items": {
                "@ref": "local:TSRelationship"
              }
            },
            "@args": "TSRelationshipArgs",
            "@resolver": {
              "name": "shapedb:getRelated",
              "service": "shapedb",
              "options": {
                "nullable": true
              }
            }
          }
        },
        "required": [
