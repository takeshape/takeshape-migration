{
  "$schema": "https://schema.takeshape.io/project-schema",
  "workflows": {},
  "defaultLocale": "en",
  "locales": [
    "en"
  ],
  "apiVersion": "1",
  "forms": {
    "Genre": {
      "default": {
        "properties": {
          "title": {
            "widget": "singleLineText"
          }
        },
        "order": [
          "title"
        ]
      }
    },
    "Tag": {
      "default": {
        "properties": {
          "name": {
            "widget": "singleLineText"
          }
        },
        "order": [
          "name"
        ]
      }
    },
    "Post": {
      "default": {
        "properties": {
          "body": {
            "widget": "wysiwygText"
          },
          "featureImage": {
            "widget": "image"
          },
          "title": {
            "widget": "singleLineText"
          },
          "author": {
            "widget": "relationship"
          },
          "deck": {
            "widget": "paragraphText"
          },
          "tags": {
            "widget": "relationship"
          }
        },
        "order": [
          "title",
          "deck",
          "tags",
          "author",
          "featureImage",
          "body"
        ]
      }
    },
    "Author": {
      "default": {
        "properties": {
          "name": {
            "widget": "singleLineText"
          },
          "photo": {
            "widget": "image"
          },
          "biography": {
            "widget": "wysiwygText"
          }
        },
        "order": [
          "name",
          "photo",
          "biography"
        ]
      }
    },
    "HomepageHero": {
      "default": {
        "properties": {
          "image": {
            "widget": "image"
          },
          "featuredPost": {
            "widget": "relationship"
          }
        },
        "widget": "object",
        "order": [
          "image",
          "featuredPost"
        ]
      }
    },
    "Homepage": {
      "default": {
        "properties": {
          "title": {
            "widget": "singleLineText"
          },
          "featuredBook": {
            "widget": "relationship"
          },
          "hero": {
            "widget": "shapeObject"
          }
        },
        "order": [
          "title",
          "hero",
          "featuredBook"
        ]
      }
    },
    "SiteSettings": {
      "default": {
        "properties": {
          "siteTitle": {
            "widget": "singleLineText"
          }
        },
        "order": [
          "siteTitle"
        ]
      }
    },
    "Asset": {
      "default": {
        "properties": {
          "path": {
            "disabled": true,
            "widget": "singleLineText"
          },
          "filename": {
            "disabled": true,
            "widget": "singleLineText"
          },
          "description": {
            "disabled": true,
            "widget": "paragraphText"
          },
          "caption": {
            "disabled": true,
            "widget": "wysiwygSingleLineText"
          },
          "uploadStatus": {
            "disabled": true,
            "widget": "singleLineText"
          },
          "mimeType": {
            "disabled": true,
            "widget": "singleLineText"
          },
          "title": {
            "disabled": true,
            "widget": "singleLineText"
          },
          "authorTag": {
            "widget": "relationship"
          },
          "credit": {
            "disabled": true,
            "widget": "wysiwygSingleLineText"
          }
        },
        "order": [
          "title",
          "authorTag",
          "description",
          "caption",
          "credit",
          "filename",
          "path",
          "mimeType",
          "uploadStatus"
        ]
      }
    },
    "Book": {
      "default": {
        "properties": {
          "author": {
            "widget": "relationship"
          },
          "coverImage": {
            "widget": "image"
          },
          "genre": {
            "widget": "relationship"
          },
          "publishDate": {
            "widget": "datetime"
          },
          "totalPages": {
            "widget": "number"
          },
          "title": {
            "widget": "singleLineText"
          },
          "type": {
            "widget": "dropdown"
          },
          "body": {
            "widget": "wysiwygText"
          }
        },
        "order": [
          "title",
          "genre",
          "publishDate",
          "coverImage",
          "author",
          "totalPages",
          "type",
          "body"
        ]
      }
    }
