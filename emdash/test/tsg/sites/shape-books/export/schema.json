            "@mapping": "shapedb:Post.BybUznPIW",
            "@backreference": {
              "enabled": true
            },
            "@ref": "local:Asset",
            "@input": {
              "@ref": "local:TSRelationship"
            },
            "@args": "TSRelationshipArgs",
            "@resolver": {
              "name": "shapedb:getRelated",
              "service": "shapedb",
              "options": {
                "nullable": true
              }
            }
          },
          "title": {
