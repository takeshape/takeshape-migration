{
  "name": "ts2emdash",
  "version": "0.1.0",
  "private": true,
  "description": "Convert a TakeShape project export into an EmDash seed file",
  "license": "MIT",
  "repository": "github:takeshape/takeshape-migration",
  "type": "module",
  "bin": {
    "ts2emdash": "./ts2emdash.mts"
  },
  "scripts": {
    "test": "npm run test:unit && node test/download-assets.mts && node test/preload.mts && node test/run.mts",
    "test:unit": "node --test test/*.test.mts test/**/*.test.mts",
    "test:tsg-golden": "node test/tsg/build-golden.mts",
    "test:tsg-templates": "node test/tsg/differential.mts",
    "test:tsg-e2e": "node test/tsg/e2e.mts",
    "typecheck": "tsc",
    "convert": "node ts2emdash.mts",
    "tsg2astro": "node tsg2astro/tsg2astro.mts",
    "compare": "node compare/compare-sites.mts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@types/js-yaml": "3.12.10",
    "@types/lodash": "4.17.25",
    "@types/node": "22.20.5",
    "@types/nunjucks": "3.2.6",
    "emdash": "1.3.1",
    "entities": "6.0.1",
    "github-slugger": "1.5.0",
    "graphql": "16.10.0",
    "image-size": "2.0.4",
    "js-yaml": "3.14.1",
    "json-variables": "10.0.5",
    "lodash": "4.17.21",
    "minimize": "2.2.0",
    "moment": "2.30.1",
    "moment-timezone": "0.5.32",
    "nunjucks": "3.2.0",
    "parse5": "7.3.0",
    "prismjs": "1.29.0",
    "sharp": "0.35.5",
    "slugg": "1.2.1",
    "typescript": "7.0.2"
  }
}
